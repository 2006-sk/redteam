# Copy to .env (gitignored) and fill in. Load with `node --env-file=.env ...`
# (the npm scripts already pass --env-file=.env).

# ── Tenki (one disposable VM per agent — the judged Tenki integration) ──
TENKI_API_KEY=tk_...
TENKI_AUTH_TOKEN=tk_...          # same value; SDK resolves AUTH_TOKEN first

# ── LLM brain (autonomous agent planning via Nebius, OpenAI-compatible) ──
NEBIUS_API_KEY=v1....
# Optional: force one model for all agents (else heterogeneous per-persona):
# BRAIN_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# LLM_BRAIN=off                  # disable the brain, run deterministic scripts only
# BRAIN_STEPS=5                  # max LLM planning steps per agent (default 5)

# Alternative brain providers (used only if NEBIUS_API_KEY is unset):
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ── Target ──
# In real mode the VMs need a PUBLIC target URL (Pranay's Wasmer app):
# TARGET_BASE_URL=https://<pranay-app>.wasmer.app
# In mock mode it defaults to http://localhost:9090 (npm run target).

# ── Coordinator ──
# PORT=8080                      # http + ws port the frontend connects to
